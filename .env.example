# Copy to .env for local MinIO/Sentra testing:
#
#   cp .env.example .env
#
# Then replace SENTRA_PASSPHRASE with a local-only value. Do not reuse a
# production backup passphrase here.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
SENTRA_MINIO_BUCKET=sentra-test

SENTRA_PASSPHRASE=replace-with-a-local-only-passphrase

# Optional local paths used by Justfile recipes.
SENTRA_DEMO_DIR=demo-data
SENTRA_RESTORE_DIR=/tmp/sentra-restored
